---
interface Props { pages: { number: number; url: string }[]; current: number }
const { pages, current } = Astro.props;
---
{pages.length > 1 && <nav class="pagination" aria-label="글 페이지">
  {current > 1 && <a href={pages[current - 2].url} rel="prev">이전</a>}
  {pages.map(page => <a href={page.url} aria-label={`${page.number} 페이지`} aria-current={page.number === current ? 'page' : undefined}>{page.number}</a>)}
  {current < pages.length && <a href={pages[current].url} rel="next">다음</a>}
</nav>}
