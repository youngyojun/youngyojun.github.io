---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/posts';
interface Props {
  title?: string;
  page: { number: number; items: Post[] };
  pages: { number: number; url: string }[];
  total: number;
}
const { title = '글 목록', page, pages, total } = Astro.props;
---
<BaseLayout title={page.number > 1 ? `${title} · ${page.number} 페이지` : title}>
  <header class="page-header"><h1>{title}</h1><p>{total}개의 글</p></header>
  <section class="post-previews" aria-label="글 목록">
    {page.items.map(post => <article>
      <time datetime={post.data.date}>{post.displayDate}</time>
      <h2><a href={post.url}>{post.data.title}</a></h2>
      <p>{post.description}</p>
      <a class="read-more" href={post.url} aria-label={`${post.data.title} 읽기`}>글 읽기 <span aria-hidden="true">→</span></a>
    </article>)}
    {!page.items.length && <p>아직 작성한 글이 없습니다.</p>}
  </section>
  <Pagination pages={pages} current={page.number} />
</BaseLayout>
