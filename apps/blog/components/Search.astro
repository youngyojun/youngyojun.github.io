---
import { Button } from '@youngyojun/ui';
---

<button id="search-toggle" class="search-toggle" type="button" aria-haspopup="dialog" aria-controls="search-dialog" hidden>검색</button>
<dialog id="search-dialog" aria-labelledby="search-heading">
  <header class="search-header">
    <h2 id="search-heading">블로그 검색</h2>
    <Button id="search-close" aria-label="검색 닫기">닫기</Button>
  </header>
  <label for="search-input">글 제목·본문</label>
  <input id="search-input" type="search" placeholder="검색어를 입력하세요" autocomplete="off" spellcheck="false" autofocus />
  <p id="search-status" role="status" aria-live="polite">검색어를 입력하세요.</p>
  <ul id="search-results" class="search-results"></ul>
</dialog>

<script>
  import '../lib/search-dialog';
</script>
