---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMathText } from '../lib/math';
import { plainText } from '../lib/text';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about content');
const { Content } = await render(page);
const titleHtml = renderMathText(page.data.title);
---
<BaseLayout title={plainText(titleHtml)}>
  <article><header class="page-header"><h1 set:html={titleHtml} /></header><div class="prose"><Content /></div></article>
</BaseLayout>
