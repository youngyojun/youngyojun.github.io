---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about content');
const { Content } = await render(page);
---
<BaseLayout title={page.data.title}>
  <article><header class="page-header"><h1>{page.data.title}</h1></header><div class="prose"><Content /></div></article>
</BaseLayout>
