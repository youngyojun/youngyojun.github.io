---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import type { tags } from '../legacy-collections';

interface Props {
  label: string;
  indexUrl: string;
  groups: typeof tags;
}

const { label, indexUrl, groups } = Astro.props;

const pageSize = 10;
---

<BaseLayout title={`${label} | Gyojun Youn's PS Blog`}>
  <h1 id="collection-title" class="page-heading">{label}</h1>
  <p id="collection-error" class="post-count" role="status" hidden>
    해당 {label} 또는 페이지를 찾을 수 없습니다. <a href={indexUrl}>{label} 목록으로</a>
  </p>
  {groups.map(group => {
    const pages = Array.from({ length: Math.ceil(group.posts.length / pageSize) }, (_, index) => index + 1);
    return pages.map(page => <section class="collection-page" data-name={group.name} data-page={page}>
      <h2 class="page-heading collection-group-heading">{group.name}</h2>
      <p class="post-count">{group.posts.length}개의 글 · {page}/{pages.length} 페이지</p>
      <PostList posts={group.posts.slice((page - 1) * pageSize, page * pageSize)} />
      {pages.length > 1 && <nav class="pagination" aria-label={`${group.name} 글 페이지`}>
        {pages.map(number => <a
          href={group.url + (number > 1 ? `/page${number}` : '')}
          aria-label={`${number} 페이지`}
          aria-current={number === page ? 'page' : undefined}
        >{number}</a>)}
      </nav>}
    </section>);
  })}
  <p class="collection-back"><a id="collection-back" href={indexUrl}>전체 {label}</a></p>
  <script>
    const pages = [...document.querySelectorAll<HTMLElement>('.collection-page')];
    const title = document.getElementById('collection-title')!;
    const error = document.getElementById('collection-error')!;
    const baseTitle = document.title;
    const label = title.textContent!;
    const indexUrl = document.querySelector<HTMLAnchorElement>('#collection-back')!.pathname;
    document.querySelectorAll<HTMLElement>('.collection-group-heading').forEach(heading => heading.hidden = true);

    function showCollection() {
      if (!location.hash || location.hash === '#/') {
        location.replace(indexUrl);
        return;
      }
      let selected: HTMLElement | undefined;
      const route = location.hash.match(/^#\/([^/]+)(?:\/page([1-9]\d*))?\/?$/);
      if (route) {
        try {
          const name = decodeURIComponent(route[1]);
          const page = route[2] ?? '1';
          selected = pages.find(section => section.dataset.name === name && section.dataset.page === page);
        } catch {
          // A malformed percent escape is an unknown route, not a script error.
        }
      }
      pages.forEach(section => section.hidden = section !== selected);
      error.hidden = !!selected;
      title.textContent = selected?.dataset.name ?? label;
      document.title = selected ? `${title.textContent} | ${baseTitle}` : baseTitle;
    }

    showCollection();
    window.addEventListener('hashchange', () => {
      showCollection();
      document.querySelector('main')?.focus();
      window.scrollTo(0, 0);
    });
  </script>
</BaseLayout>
