---
import { posts } from '../posts';
import { homePages } from '../legacy-home-pages';
import { legacyExcerptSource, legacyProcessor } from '../legacy-markdown';
import BaseLayout from '../layouts/BaseLayout.astro';
import MathJax from './MathJax.astro';

interface Props {
  page: typeof homePages[number];
}

const { page } = Astro.props;
if (!Astro.site) throw new Error('Home excerpts require a configured site URL');
const renderer = await legacyProcessor(Astro.site.href).createRenderer({});
const previews = await Promise.all(page.posts.map(async post => ({
  post,
  excerpt: (await renderer.render(legacyExcerptSource(post.body))).code,
})));
---

<BaseLayout>
  <h1 class="page-heading">글 목록</h1>
  <p class="post-count">{posts.length}개의 글 · {page.number}/{homePages.length} 페이지</p>
  <section class="home-posts" aria-label="글 미리보기">
    {previews.map(({ post, excerpt }) => <article>
      <header class="post-header">
        <h2 class="post-title"><a class="post-title-link" href={post.url}>{post.data.title}</a></h2>
        <p class="post-meta">작성일 <time datetime={post.publishedAt}>{post.displayDate}</time></p>
      </header>
      <div class="post-body" set:html={excerpt} />
      <p class="post-more"><a href={`${post.url}#`} rel="contents" aria-label={`${post.data.title} 더 읽어보기`}>더 읽어보기 »</a></p>
    </article>)}
  </section>
  {homePages.length > 1 && <nav class="pagination" aria-label="글 목록 페이지">
    {page.number > 1 && <a href={homePages[page.number - 2].url} rel="prev">이전</a>}
    {homePages.map(({ number, url }) => <a href={url} aria-label={`${number} 페이지`} aria-current={number === page.number ? 'page' : undefined}>{number}</a>)}
    {page.number < homePages.length && <a href={homePages[page.number].url} rel="next">다음</a>}
  </nav>}
  <MathJax slot="scripts" />
</BaseLayout>
