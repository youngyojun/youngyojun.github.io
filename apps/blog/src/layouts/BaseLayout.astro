---
import '@youngyojun/design-tokens/tokens.css';
import '../styles/site.css';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
  noindex?: boolean;
}

const siteTitle = "Gyojun Youn's PS Blog";
const { title = siteTitle, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {noindex
      ? <meta name="robots" content="noindex" />
      : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="brand" href="/">{siteTitle}</a>
      <p class="site-subtitle">@youngyojun, @GyojunYoun, and @yclock's PS Blog</p>
      <nav class="site-nav" aria-label="사이트">
        <a href="/">홈</a>
        <a href="/about/">소개</a>
        <a href="/categories/">카테고리</a>
        <a href="/archives/">아카이브</a>
        <a href="/tags/">태그</a>
        <Search />
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">Gyojun Youn</footer>
    <slot name="scripts" />
    <script>
      document.querySelector('.skip-link')!.addEventListener('click', event => {
        // Keep hash-based pagination intact when moving focus to the main content.
        event.preventDefault();
        const main = document.getElementById('main')!;
        main.focus();
        main.scrollIntoView();
      });
    </script>
  </body>
</html>
