---
import { posts } from '../posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import MathJax from '../components/MathJax.astro';
import { render } from 'astro:content';

export function getStaticPaths() {
  return posts.flatMap(post => {
    // shortcut: serve legacy aliases until the redirect policy is agreed.
    const paths = post.legacyUrl ? [post.url, post.legacyUrl] : [post.url];
    return paths.map(path => ({
      params: { path: decodeURIComponent(path.slice(1, -1)) },
      props: { post },
    }));
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} canonicalPath={post.url}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <dl class="post-meta">
        <div>
          <dt>작성일</dt>
          <dd><time datetime={post.publishedAt}>{post.displayDate}</time></dd>
        </div>
        <div>
          <dt>카테고리</dt>
          <dd>{post.categories.map((category, index) => <>
            {index > 0 && ' / '}<a href={`/category/#/${encodeURIComponent(category)}`} rel="index">{category}</a>
          </>)}</dd>
        </div>
        {post.tags.length > 0 && <div>
          <dt>태그</dt>
          <dd>{post.tags.map((tag, index) => <>
            {index > 0 && ', '}<a href={`/tag/#/${encodeURIComponent(tag)}`} rel="tag"># {tag}</a>
          </>)}</dd>
        </div>}
      </dl>
    </header>
    <div class="post-body"><Content /></div>
  </article>
  <MathJax slot="scripts" />
</BaseLayout>
