---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { posts } from '../../posts';

const pageSize = 10;
const pages = Array.from({ length: Math.ceil(posts.length / pageSize) }, (_, index) => ({
  number: index + 1,
  posts: posts.slice(index * pageSize, (index + 1) * pageSize),
}));
---

<BaseLayout title="아카이브 | Gyojun Youn's PS Blog">
  <h1 class="page-heading">아카이브</h1>
  <p class="post-count">총 {posts.length}개의 글</p>
  <p id="archive-error" class="post-count" role="status" hidden>
    해당 페이지를 찾을 수 없습니다. <a href="/archives/">아카이브 첫 페이지로</a>
  </p>
  {pages.map(page => <section class="archive-page" data-page={page.number} aria-label={`${page.number} 페이지`}>
    {[...new Set(page.posts.map(post => post.displayDate.slice(0, 4)))].map(year => <div>
      <h2 class="archive-year">{year}</h2>
      <PostList posts={page.posts.filter(post => post.displayDate.startsWith(year))} shortDate />
    </div>)}
    {pages.length > 1 && <nav class="pagination" aria-label="아카이브 페이지">
      {pages.map(({ number }) => <a
        href={`/archives/#/${number > 1 ? `page${number}` : ''}`}
        aria-label={`${number} 페이지`}
        aria-current={number === page.number ? 'page' : undefined}
      >{number}</a>)}
    </nav>}
  </section>)}
  <script>
    const pages = [...document.querySelectorAll<HTMLElement>('.archive-page')];
    const error = document.getElementById('archive-error')!;

    function showPage() {
      const route = location.hash.match(/^#\/(?:page([1-9]\d*))?\/?$/);
      const page = !location.hash ? '1' : route ? route[1] ?? '1' : undefined;
      const selected = pages.find(section => section.dataset.page === page);
      pages.forEach(section => section.hidden = section !== selected);
      error.hidden = !!selected;
    }

    showPage();
    window.addEventListener('hashchange', () => {
      showPage();
      document.querySelector('main')?.focus();
      window.scrollTo(0, 0);
    });
  </script>
</BaseLayout>
