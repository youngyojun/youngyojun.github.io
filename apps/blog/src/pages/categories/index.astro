---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../legacy-collections';
---

<BaseLayout title="카테고리 | Gyojun Youn's PS Blog">
  <h1 class="page-heading">카테고리</h1>
  <p class="post-count">총 {categories.length}개의 카테고리</p>
  <ul class="category-list">
    {categories.map(category => <li>
      <a href={category.url}>{category.name} <span class="collection-count">({category.posts.length})</span></a>
    </li>)}
  </ul>
</BaseLayout>
