---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tags } from '../../legacy-collections';
---

<BaseLayout title="태그 | Gyojun Youn's PS Blog">
  <h1 class="page-heading">태그</h1>
  <p class="post-count">총 {tags.length}개의 태그</p>
  <ul class="tag-list">
    {tags.map(tag => <li>
      <a href={tag.url}>{tag.name} <span class="collection-count">({tag.posts.length})</span></a>
    </li>)}
  </ul>
</BaseLayout>
