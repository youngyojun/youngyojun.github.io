---
interface Props { to: string }
const { to } = Astro.props;
if (!to.startsWith('/') || to.startsWith('//')) throw new Error('Redirect targets must be same-site paths');
---
<!doctype html>
<html lang="ko" data-redirect={to}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>페이지가 이동했습니다</title>
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <noscript><meta http-equiv="refresh" content={`0;url=${to}`} /></noscript>
  </head>
  <body>
    <main><h1>페이지가 이동했습니다.</h1><p><a href={to}>새 주소로 이동하기</a></p></main>
    <script>
      const { redirect } = document.documentElement.dataset;
      if (redirect) location.replace(redirect + location.hash);
    </script>
    <style>body { max-width: 42rem; margin: 4rem auto; padding: 1.5rem; font: 1rem/1.8 system-ui, sans-serif; color: #333; }</style>
  </body>
</html>
