---
import '@youngyojun/design-tokens/tokens.css';
import '../styles/home.css';
import { appPaths, siteUrl } from '../../../site.config.ts';

interface Props { title?: string; description: string; lang?: 'en' | 'ko' }
const { title, description, lang = 'en' } = Astro.props;
const pageTitle = title ? `${title} | Gyojun Youn` : 'Gyojun Youn';
const canonical = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/atom+xml" title="Writing by Gyojun Youn" href={`${appPaths.blog}atom.xml`} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}</a>
    <header class="home-header shell">
      <a class="wordmark" href="/" aria-label="Gyojun Youn — Home">gy<span>.</span></a>
      <nav aria-label="Main">
        <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a><a href="/#work">Work</a><a href="/#writing">Writing</a>
        <a class="blog-link" href={appPaths.blog}>Blog <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="home-footer shell"><div class="footer-bottom"><span>© <span id="copyright-year">{new Date().getFullYear()}</span> Gyojun Youn</span><div><a href="https://github.com/youngyojun">GitHub</a><a href="https://codeforces.com/profile/GyojunYoun">Codeforces</a><a href="#top">Back to top ↑</a></div></div></footer>
    <script>
      document.querySelector('#copyright-year')!.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
