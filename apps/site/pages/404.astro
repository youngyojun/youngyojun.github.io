---
import '@youngyojun/design-tokens/tokens.css';
import { appPaths } from '../../../site.config.ts';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>페이지를 찾을 수 없습니다</title>
  </head>
  <body>
    <main>
      <p>404</p>
      <h1>페이지를 찾을 수 없습니다.</h1>
      <p>주소를 확인하거나 홈에서 다시 찾아보세요.</p>
      <nav aria-label="돌아가기">
        <a href="/">홈으로 돌아가기</a>
        <a href={appPaths.blog}>블로그로 돌아가기 →</a>
      </nav>
    </main>
  </body>
</html>
<style>
  body { margin: 0; color: var(--color-text); background: var(--color-background); font: 1rem/1.9 var(--font-body); }
  main { max-width: var(--content-width); margin: 15vh auto; padding: 1.25rem; text-align: center; }
  h1 { color: var(--color-heading); font-size: clamp(1.5rem, 5vw, 2rem); word-break: keep-all; }
  nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1.5rem; }
  a { display: inline-block; min-height: 44px; color: inherit; text-underline-offset: .2em; }
  a:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; }
</style>
