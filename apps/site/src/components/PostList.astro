---
import type { posts as blogPosts } from '../legacy-posts';

interface Props {
  posts: typeof blogPosts;
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map(post => <li>
    <time datetime={post.publishedAt}>{post.displayDate}</time>{' '}
    <a href={post.url}>{post.frontmatter.title}</a>
  </li>)}
</ul>
