---
import type { posts as blogPosts } from '../legacy-posts';

interface Props {
  posts: typeof blogPosts;
  shortDate?: boolean;
}

const { posts, shortDate = false } = Astro.props;
---

<ul class="post-list">
  {posts.map(post => <li>
    <time datetime={post.publishedAt}>{shortDate ? post.displayDate.slice(5) : post.displayDate}</time>{' '}
    <a href={post.url}>{post.frontmatter.title}</a>
  </li>)}
</ul>
