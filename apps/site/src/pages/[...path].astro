---
import { posts } from '../legacy-posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import MathJax from '../components/MathJax.astro';

export function getStaticPaths() {
  return posts.map(post => ({
    params: { path: decodeURIComponent(post.url.slice(1, -1)) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, frontmatter } = post;
---

<BaseLayout title={frontmatter.title}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{frontmatter.title}</h1>
      <dl class="post-meta">
        <div>
          <dt>작성일</dt>
          <dd><time datetime={post.publishedAt}>{post.displayDate}</time></dd>
        </div>
        <div>
          <dt>카테고리</dt>
          <dd>{post.categories.map((category, index) => <>
            {index > 0 && ' / '}<a href={`/category/#/${encodeURIComponent(category)}`} rel="index">{category}</a>
          </>)}</dd>
        </div>
        {post.tags.length > 0 && <div>
          <dt>태그</dt>
          <dd>{post.tags.map((tag, index) => <>
            {index > 0 && ', '}<a href={`/tag/#/${encodeURIComponent(tag)}`} rel="tag"># {tag}</a>
          </>)}</dd>
        </div>}
      </dl>
    </header>
    <div class="post-body"><Content /></div>
  </article>
  <MathJax slot="scripts" />
</BaseLayout>
