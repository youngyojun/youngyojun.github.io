---
import { posts } from '../legacy-posts';
import BaseLayout from '../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return posts.map(post => ({
    params: { path: decodeURIComponent(post.url.slice(1, -1)) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, frontmatter } = post;
---

<BaseLayout title={frontmatter.title}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{frontmatter.title}</h1>
      <dl class="post-meta">
        <div>
          <dt>작성일</dt>
          <dd><time datetime={post.publishedAt}>{post.displayDate}</time></dd>
        </div>
        <div>
          <dt>카테고리</dt>
          <dd>{post.categories.join(' / ')}</dd>
        </div>
        {post.tags.length > 0 && <div>
          <dt>태그</dt>
          <dd>{post.tags.map(tag => `# ${tag}`).join(', ')}</dd>
        </div>}
      </dl>
    </header>
    <div class="post-body"><Content /></div>
  </article>
  <Fragment slot="scripts">
    <script is:inline type="text/x-mathjax-config">
      MathJax.Hub.Config({
        // Incomplete local STIX fonts can render calligraphic letters as missing glyphs.
        'HTML-CSS': { availableFonts: [] },
        tex2jax: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          processEscapes: true,
          skipTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
        },
      });
    </script>
    <script is:inline src="https://cdn.bootcss.com/mathjax/2.7.1/latest.js?config=TeX-AMS-MML_HTMLorMML"></script>
  </Fragment>
</BaseLayout>
