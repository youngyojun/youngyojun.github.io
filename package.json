{
  "name": "youngyojun-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @youngyojun/blog dev",
    "check": "corepack pnpm -r check && tsc --project scripts/tsconfig.json && corepack pnpm rust:check",
    "test": "corepack pnpm build && corepack pnpm test:built",
    "test:built": "corepack pnpm -r test:built && node --test scripts/*.test.ts && corepack pnpm rust:test",
    "rust:check": "cargo fmt --all -- --check && cargo clippy --locked --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --locked --workspace",
    "build": "corepack pnpm -r build && node scripts/assemble-site.ts",
    "preview": "node apps/site/preview.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
