{
  "name": "youngyojun-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @youngyojun/blog dev",
    "check": "corepack pnpm -r check && tsc --project scripts/tsconfig.json",
    "test": "corepack pnpm -r test && node --test scripts/*.test.ts",
    "build": "corepack pnpm -r build && node scripts/assemble-site.ts",
    "preview": "node apps/blog/preview.mjs",
    "test:e2e": "corepack pnpm --filter @youngyojun/blog test:e2e"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
